rules_version = '2';

// ============================================================
// NBA V2 — Firestore Security Rules
// ============================================================
// HOW TO APPLY THIS FILE:
// Firebase Console → your project → Build → Firestore Database
// → Rules tab → replace the contents with this file → Publish.
// (Firestore rules live on Firebase's servers, not in your app's
// code, so this file has to be pasted in manually — it is not
// deployed automatically by hosting your site on Vercel.)
//
// DESIGN
// NBA V1 supports exactly one business per signed-in user (no
// business-switcher exists in the UI), so script.js uses the
// Firebase Auth UID directly as the business document ID:
//   businesses/{uid}
// That makes ownership a single, simple check: the signed-in
// user's UID must equal the document ID they're trying to
// read or write. There is no email-based or role-based access
// anywhere — only "is this your own UID".
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // A user's own account-level document, if one is ever added later.
    // Not currently written by script.js, but reserved so a future
    // per-user (non-business) document has a safe rule already in place.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // The one business document per user (id == uid), which is where the
    // whole business snapshot (script.js: collectBackupData()) lives.
    match /businesses/{businessId} {
      allow read, write: if request.auth != null && request.auth.uid == businessId;
    }

    // Everything else is denied by default (Firestore's implicit default
    // for anything not explicitly matched above is already "deny" — this
    // line makes that explicit rather than relying on the implicit one).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
